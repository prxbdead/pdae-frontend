{
  "name": "Hodlo",
  "slug": "pdae",
  "version": "0.0.1",
  "scheme": "pdae",
  "userInterfaceStyle": "automatic",
  "plugins": [
    "expo-router",
    "expo-status-bar",
    "expo-font",
    "expo-splash-screen",
    "expo-image"
  ],
  "android": {
    "package": "com.pdae.app"
  },
  "web": {
    "bundler": "metro",
    "output": "single",
    "favicon": "./assets/favicon.png",
    "name": "Hodlo",
    "shortName": "Hodlo",
    "themeColor": "#6C4CF1",
    "backgroundColor": "#F5F2FF",
    "display": "standalone",
    "startUrl": "/"
  }
}

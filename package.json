    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^29.6.3",
    "jest-expo": "^58.0.15",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.3.0",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
